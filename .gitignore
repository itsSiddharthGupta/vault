#vscode
.vscode/

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
gradle.properties

# Local configuration file (sdk path, etc)
local.properties

# Android Studio
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Version control
vcs.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Kotlin
*.kotlin_module

# macOS
.DS_Store

# Media cache (ExoPlayer)
**/media_cache/

# Gradle wrapper (include these)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Hilt generated files
**/build/generated/hilt/
**/build/generated/ap_generated_sources/

# Compose compiler generated files
**/build/compose/
